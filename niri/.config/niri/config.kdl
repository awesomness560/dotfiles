// ~/.config/niri/config.kdl

// ---------------------------------------------------------------
// PERSISTENT WORKSPACES
// Named workspaces always exist, even when empty. Nothing opens
// on them until you move something there — niri never auto-assigns
// windows to a workspace unless you write an open-on-workspace rule.
// Don't add any and you get exactly what you asked for.
// ---------------------------------------------------------------

workspace "1"
workspace "2"
workspace "3"
workspace "4"
workspace "5"
workspace "6"

// ---------------------------------------------------------------

environment {
    EDITOR "nvim"
}

input {
    keyboard {
        repeat-delay 300
        repeat-rate 50
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
    warp-mouse-to-focus
}

layout {
    gaps 8
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#a3a3ff"
        inactive-color "#505050"
    }
    border { off; }
}

spawn-at-startup "noctalia"

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y%m%d-%H%M%S.png"

debug {
    // Required for Noctalia notification actions
    honor-xdg-activation-with-invalid-serial
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="dev.noctalia.Noctalia.Settings"
    open-floating true
}

window-rule {
    match app-id="^floatdisk$"
    open-floating true
    default-column-width { fixed 720; }
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

window-rule {
    match app-id="^zen$"
    match app-id="^vesktop$"
    match app-id="^Godot$"
    match app-id="^Music Parry"
    default-column-width { proportion 1.0; }
}

window-rule {
    match app-id=r#"^file_chooser$"#
    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.7; }
}

overview {
    // How far out it zooms. Lower = more workspaces visible at once,
    // smaller thumbnails. Range is roughly 0.0–0.75.
    zoom 0.35


    // Drop these if you prefer flat tiles
    workspace-shadow {
        softness 40
        spread 5
        offset x=0 y=10
        color "#00000060"
    }
}

// ---------------------------------------------------------------
// KEYBINDS
// ---------------------------------------------------------------

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+Return hotkey-overlay-title="Terminal"     { spawn "kitty"; }
    // Mod+D      hotkey-overlay-title="App launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+E      hotkey-overlay-title="File manager" { spawn "kitty" "--class" "yazi" "-e" "yazi"; }
    Mod+B      hotkey-overlay-title="Browser"      { spawn-sh "xdg-open https://"; }

    Mod+grave hotkey-overlay-title="Move to other monitor" { move-column-to-monitor-next; }
    Mod+W { spawn-sh "noctalia msg panel-toggle wallpaper"; }

    // Window
    Mod+Q       { close-window; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F  { maximize-column; }
    Mod+Space   { toggle-window-floating; }
    Mod+R       { switch-preset-column-width; }

    // Launcher — opens on the current workspace
    Mod+D { spawn-sh "noctalia msg panel-toggle launcher"; }

    // Launcher — jumps to scratch first
    Mod+Shift+D { spawn-sh "niri msg action focus-workspace 6; noctalia msg panel-toggle launcher"; }

    // Overview — opens where you are
    Mod+Tab { toggle-overview; }

    // Overview — opens centered on 5
    Mod+Shift+Tab { spawn-sh "niri msg action focus-workspace 5; niri msg action open-overview"; }

    Mod+Ctrl+R hotkey-overlay-title="Record region (toggle)" { spawn-sh "$HOME/.config/niri/scripts/record.sh"; }

    Mod+Shift+R { spawn "sh" "-c" "pkill -x noctalia; sleep 0.2; noctalia"; }
    // Focus
    //
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Move window within the strip
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    // Build a column out of two windows (the one niri-ism worth learning)
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Resize
    Mod+Shift+Left  { set-column-width "-10%"; }
    Mod+Shift+Right { set-column-width "+10%"; }

    // Workspaces

    Mod+1 { spawn "/home/srang/.config/niri/scripts/ws-toggle.sh" "1"; }
    Mod+2 { spawn "/home/srang/.config/niri/scripts/ws-toggle.sh" "2"; }
    Mod+3 { spawn "/home/srang/.config/niri/scripts/ws-toggle.sh" "3"; }
    Mod+4 { spawn "/home/srang/.config/niri/scripts/ws-toggle.sh" "4"; }
    Mod+5 { spawn "/home/srang/.config/niri/scripts/ws-toggle.sh" "5"; }
    Mod+6 { spawn "/home/srang/.config/niri/scripts/ws-toggle.sh" "6"; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }
    Mod+Shift+6 { move-column-to-workspace "6"; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+WheelScrollDown { focus-column-right; }
    Mod+WheelScrollUp   { focus-column-left; }

    // Mod+Tab   { toggle-overview; }
    Mod+A { focus-workspace-previous; }

    // System
    Ctrl+Alt+L      { spawn-sh "noctalia msg session lock"; }
    Ctrl+Alt+P      { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+S           { spawn-sh "noctalia msg panel-toggle control-center"; }
    Ctrl+Alt+Delete { quit; }
    Mod+Z { spawn-sh "noctalia msg settings-toggle"; }

    // Screenshots
    Mod+Shift+S { screenshot; }
    Mod+Print   { screenshot-screen; }

    // Hardware keys
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
}
